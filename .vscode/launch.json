{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Go (debug)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend",
      "cwd": "${workspaceFolder}/backend",
      "args": []
    },
    {
      "name": "Frontend: Vite Dev",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "frontend: npm run dev"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Backend: Go (debug)", "Frontend: Vite (msedge)"]
    }
  ]
}
